{
  "expo": {
    "name": "Sydney Sound Map",
    "slug": "bx5hztrzurxiw0b05s4jg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "V-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.bx5hztrzurxiw0b05s4jg",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Soundscape Sydney uses your location to show nearby sound locations on the map and provide live navigation.",
        "NSMicrophoneUsageDescription": "Soundscape Sydney uses your microphone to measure approximate ambient sound levels on the decibel meter screen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.bx5hztrzurxiw0b05s4jg"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Soundscape Sydney uses your location to show nearby sound locations and navigate to them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}